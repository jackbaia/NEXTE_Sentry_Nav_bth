<launch>
<!-- Launch file for Livox AVIA LiDAR - 隧道优化版本 -->

	<arg name="rviz" default="true" />
	<arg name="use_sim_time" value="true"/>
	<arg name="map" default="/home/bob/mid_ros/src/FAST_LIO/PCD/scans.pcd" />

	<!-- fast_lio - 隧道优化参数 -->
	<rosparam command="load" file="$(find fast_lio)/config/mid360.yaml" />
	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="5"/>  <!-- 增加过滤，减少计算量 -->
	<param name="max_iteration" type="int" value="2" />    <!-- 减少迭代次数 -->
	<param name="filter_size_surf" type="double" value="0.8" />  <!-- 增加过滤尺寸 -->
	<param name="filter_size_map" type="double" value="0.8" />   <!-- 增加过滤尺寸 -->
	<param name="cube_side_length" type="double" value="2500" /> <!-- 增加地图大小到2.5km -->
	<param name="runtime_pos_log_enable" type="bool" value="0" />
    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" /> 

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio_localization)/rviz_cfg/sentry_build_map.rviz" />
	</group>

	<!-- build 2d map - 隧道优化 -->
	<include file="$(find fast_lio)/launch/Pointcloud2Map.launch">
	</include>

	<!-- pointscloud2 to laserscans - 隧道优化 -->
	<include file="$(find fast_lio_localization)/launch/PointsCloud2toLaserscan.launch">
	</include>

	<!-- 发布一个雷达body到机器人足端body_foot的静态映射 -->
	<node pkg="tf2_ros" type="static_transform_publisher" name="tf_pub_1" args="-0.0 -0.0 0 0 0 0 body body_foot" />
	<!-- 发布一个雷达初始位置camera_init到机器人足端初始位置body_init的静态映射 -->
	<node pkg="tf2_ros" type="static_transform_publisher" name="tf_pub_2" args="-0.0 -0.0 0 0 0 0 camera_init robot_foot_init" />

	<!-- 隧道建图优化参数 -->
	<param name="octomap_server/resolution" value="0.2" />  <!-- 降低分辨率，减少内存 -->
	<param name="octomap_server/pointcloud_max_z" value="2.0" />  <!-- 增加高度范围 -->
	<param name="octomap_server/pointcloud_min_z" value="-0.5" /> <!-- 降低最小高度 -->

</launch> 